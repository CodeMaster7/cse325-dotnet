@model MvcMovie.Models.MovieGenreViewModel

@{
    ViewData["Title"] = "My Movies";
}

<h1>My Movies</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<form asp-controller="Movies" asp-action="Index" method="get" class="movies-filter">
    <p class="movies-filter__row">
        <label class="movies-filter__label">
            Genre:
            <select class="movies-filter__control" asp-for="MovieGenre" asp-items="Model.Genres">
                <option value="">All</option>
            </select>
        </label>

        <label class="movies-filter__label">
            From year (or newer):
            <select class="movies-filter__control" asp-for="ReleaseYear" asp-items="Model.ReleaseYears">
                <option value="">Any</option>
            </select>
        </label>

        <label class="movies-filter__label">
            Title:
            <input class="movies-filter__control" type="search" asp-for="SearchString" autocomplete="off" />
        </label>

        <input class="movies-filter__submit" type="submit" value="Filter" />
        <a class="movies-filter__clear" asp-action="Index">Clear filters</a>
    </p>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].Rating)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Movies!)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ReleaseDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Genre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Rating)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

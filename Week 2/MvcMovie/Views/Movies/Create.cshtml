@model MvcMovie.Models.Movie

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Movie</h4>
<hr class="movie-form__divider" />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" class="movie-form">
            <div asp-validation-summary="ModelOnly" class="text-danger movie-form__validation-summary"></div>
            <div class="movie-form__field">
                <label asp-for="Title" class="movie-form__label"></label>
                <input asp-for="Title" class="form-control movie-form__control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="movie-form__field">
                <label asp-for="ReleaseDate" class="movie-form__label"></label>
                <input asp-for="ReleaseDate" class="form-control movie-form__control" />
                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
            </div>
            <div class="movie-form__field">
                <label asp-for="Genre" class="movie-form__label"></label>
                <input asp-for="Genre" class="form-control movie-form__control" />
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>
            <div class="movie-form__field">
                <label asp-for="Price" class="movie-form__label"></label>
                <input asp-for="Price" class="form-control movie-form__control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="movie-form__field">
                <label asp-for="Rating" class="movie-form__label"></label>
                <input asp-for="Rating" class="form-control movie-form__control" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
            <div class="movie-form__actions">
                <input type="submit" value="Create" class="btn btn-primary movie-form__submit" />
            </div>
        </form>
    </div>
</div>

<div class="movie-form__back">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
